# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# GitHub org whose PRs are managed
VITE_GITHUB_ORG=univelop
# Default repos (comma-separated, empty = all org repos); changeable in the app per device
VITE_REPOS=aya
# SQUASH | MERGE | REBASE
VITE_MERGE_METHOD=SQUASH
